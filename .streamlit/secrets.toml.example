# Copie para .streamlit/secrets.toml (local) ou cole nos Secrets do app no Streamlit Community Cloud.

# ---- Painel administrativo ----
ADMIN_USUARIO = "admin"
ADMIN_SENHA = "troque-esta-senha"
# Cifra as chaves de API cadastradas no painel (qualquer frase longa e aleatória).
CHAVES_CRIPTO_SECRET = "uma-frase-longa-e-aleatoria"

# ---- Banco (ChromaDB) ----
# Sem nada configurado, usa uma pasta local (CHROMA_PATH, padrão ./dados/chroma).
# No Streamlit Community Cloud o disco é efêmero: use o Chroma Cloud (trychroma.com).
# CHROMA_API_KEY = "ck-..."
# CHROMA_TENANT = "..."
# CHROMA_DATABASE = "simulador"
# Ou um servidor Chroma próprio:
# CHROMA_HOST = "chroma.seudominio.com"
# CHROMA_PORT = 8000
# CHROMA_SSL = "true"
# CHROMA_TOKEN = "..."

# ---- Chaves de IA (opcional: o painel Admin → Chaves de API tem prioridade) ----
# OPENAI_API_KEY = "sk-..."
# ANTHROPIC_API_KEY = "sk-ant-..."
# GOOGLE_GENERATIVE_AI_API_KEY = "AIza..."

# ---- Padrões dos limites de capacidade (opcional; o painel tem prioridade) ----
# SIMULADOR_MAX_SESSOES = 50
# SIMULADOR_MAX_SESSOES_IP = 10
# SIMULADOR_MAX_INICIOS_HORA = 30
# SIMULADOR_MINUTOS_SEM_SINAL = 15
